-- [[ RAINBOW LOOP ]]
task.spawn(function()
    local hue = 0
    while task.wait() do
        hue = (hue + 1/400) % 1
        local rainbow = Color3.fromHSV(hue, 0.7, 1)
        MainStroke.Color = rainbow
        Title.TextColor3 = rainbow
    end
end)

-- [[ VERIFICATION LOGIC ]]
local function validate()
    Status.Text = "Status: Verifying..."
    Status.TextColor3 = Color3.fromRGB(255, 255, 0)
    
    local success, systemKey = pcall(function()
        return game:HttpGet(KEY_URL):gsub("%s+", "")
    end)
    
    if success and KeyInput.Text == systemKey then
        Status.Text = "Status: Access Granted!"
        Status.TextColor3 = Color3.fromRGB(0, 255, 0)
        task.wait(1)
        KeyUI:Destroy()
        -- EXECUTES YOUR FULL SCRIPT
        loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
    else
        Status.Text = "Status: Invalid or Connection Error"
        Status.TextColor3 = Color3.fromRGB(255, 0, 0)
        task.wait(2)
        Status.Text = "Status: Awaiting Input"
        Status.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end

SubmitBtn.MouseButton1Click:Connect(validate)

GetKeyBtn.MouseButton1Click:Connect(function()
    setclipboard("https://pastebin.com/gpP1uCSK")
    GetKeyBtn.Text = "LINK COPIED!"
    task.wait(2)
    GetKeyBtn.Text = "GET KEY"
end)
